---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EkzHinweis from '../../components/EkzHinweis.astro';
import legsData from '../../../public/leg/data/legs.json';

const zonen = legsData.map((leg, index) => ({
  name: leg.name,
  color: leg.color,
  legId: index + 1,
  status: leg.status || 'geplant'
}));

const statusMeta: Record<string, { label: string; dotClass: string; textClass: string }> = {
  geplant:    { label: 'Geplant',      dotClass: 'bg-slate-300', textClass: 'text-slate-500' },
  erfassung:  { label: 'In Erfassung', dotClass: 'bg-amber-400', textClass: 'text-amber-700' },
  angemeldet: { label: 'Angemeldet',   dotClass: 'bg-blue-500',  textClass: 'text-blue-700'  },
  aktiv:      { label: 'Aktiv',        dotClass: 'bg-green-500', textClass: 'text-green-700' },
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ── Preismodell ─────────────────────────────────────────────
// LEG-Energiepreis gemäss Teilnahmebedingungen Ziff. 5.2, für Konsumenten und Produzenten gleich.
const LEG_ENERGIE = 12;
// Abschlag auf den EKZ-Netznutzungstarif für LEG-Strom (gleiche Netzebene).
const LEG_NETZRABATT = 0.4;

// EKZ-Tarife für Privatkunden in Rp./kWh inkl. MWST (Quelle: ekz.ch/tarife).
// netz = EKZ Netz 400ST (Standardtarif), netzBasis = EKZ Netz 400F (Basistarif).
// abgaben = SDL + Bundesabgaben + Stromreserve + solidarisierte Kosten + Förderung Energieeffizienz.
const ekzTarife = [
  { jahr: 2027, energieWinter: 14.05, energieSommer: 9.51, netz: 8.43, netzBasis: 7.95, abgaben: 0.21 + 2.49 + 0.18 + 0.21 + 0.17 },
  { jahr: 2026, energieWinter: 14.38, energieSommer: 9.73, netz: 8.60, netzBasis: 8.11, abgaben: 0.29 + 2.49 + 0.44 + 0.05 + 0.17 },
];

const rp = (n: number) => n.toFixed(2);
const preisTabellen = ekzTarife.map(t => {
  const legNetz = t.netz * (1 - LEG_NETZRABATT);
  return {
    jahr: t.jahr,
    zeilen: [
      { label: 'Energie',     hinweis: 'LEG-Strom: an die LEG · EKZ-Strom: an EKZ', leg: LEG_ENERGIE, winter: t.energieWinter, sommer: t.energieSommer },
      { label: 'Netznutzung', hinweis: 'an EKZ – für LEG-Strom mit 40% Rabatt',     leg: legNetz,     winter: t.netz,          sommer: t.netz },
      { label: 'Abgaben',     hinweis: 'an EKZ – SDL, Bundesabgaben, Stromreserve u. a.', leg: t.abgaben, winter: t.abgaben,   sommer: t.abgaben },
    ],
    total: {
      leg: LEG_ENERGIE + legNetz + t.abgaben,
      winter: t.energieWinter + t.netz + t.abgaben,
      sommer: t.energieSommer + t.netz + t.abgaben,
    },
    basisDiff: (t.netz - t.netzBasis) * (1 - LEG_NETZRABATT),
    basisDiffEkz: t.netz - t.netzBasis,
  };
});
---
<BaseLayout
  title="Lokale Elektrizitäts­gemeinschaft (LEG)"
  description="Solarbonstetten verwaltet die Lokalen Elektrizitätsgemeinschaften in Bonstetten. Strom aus der Nachbarschaft – günstig und lokal."
>

  <EkzHinweis />

  <!-- Hero -->
  <div class="relative overflow-hidden" style="padding: 3.5rem 0 5rem">
    <div class="hero-bg-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
    </div>
    <div class="container grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 xl:gap-16 items-start">
      <div>
        <span class="badge">LEG Bonstetten</span>
        <h1 class="mb-6">Strom aus der Nachbarschaft</h1>
        <p class="text-lg text-slate-500 max-w-xl leading-relaxed mb-8">
          Solarbonstetten verwaltet die lokalen Elektrizitätsgemeinschaften (LEG) der Gemeinde Bonstetten –
          kostenlos und ehrenamtlich. Seit Januar 2026 ermöglicht das Schweizer Recht den direkten
          Tausch von Solarstrom im Quartier: günstiger und nachhaltiger als je zuvor.
        </p>
        <a href={`${base}/leg/anmeldung`} class="btn btn-primary">Jetzt anmelden →</a>
      </div>

      <!-- Kennzahlen-Card -->
      <div class="glass-card p-8 rounded-2xl flex flex-col gap-6" style="align-items: stretch">
        <div class="flex items-start gap-4">
          <span class="text-3xl">⚡</span>
          <div>
            <p class="font-bold text-slate-900 mb-1">Stabiler Energiepreis</p>
            <p class="text-sm text-slate-500 leading-relaxed">
              LEG-Strom kostet <strong class="text-amber-700">{LEG_ENERGIE} Rp./kWh</strong> – das ganze Jahr,
              unabhängig von Saison und Strombörse. Mit Netznutzung und Abgaben bezahlst du unter dem Strich nicht mehr als im EKZ-Standardtarif.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-3xl">🌞</span>
          <div>
            <p class="font-bold text-slate-900 mb-1">Faire Vergütung</p>
            <p class="text-sm text-slate-500 leading-relaxed">Produzenten erhalten dieselben {LEG_ENERGIE} Rp./kWh – planbar statt schwankender Marktpreise.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-3xl">🏘️</span>
          <div>
            <p class="font-bold text-slate-900 mb-1">Lokal &amp; direkt</p>
            <p class="text-sm text-slate-500 leading-relaxed">Strom bleibt in Bonstetten – kein langer Transport, maximale lokale Wertschöpfung.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Adress-Lookup -->
  <section class="section">
    <div class="container max-w-2xl">
      <div class="text-center mb-8">
        <span class="badge mb-4 inline-block">Schnellcheck</span>
        <h2 class="mb-3">Finde deine LEG-Zone</h2>
        <p class="text-slate-500 leading-relaxed">Gib deine Adresse ein und sieh sofort, in welcher Zone du bist.</p>
      </div>
      <div class="relative" id="lookup-wrapper">
        <input
          type="search"
          id="addr-search"
          placeholder="z. B. Dorfstrasse 24…"
          autocomplete="off"
          class="addr-input w-full px-5 py-4 text-base border-2 border-slate-200 rounded-2xl focus:outline-none focus:border-amber-400 focus:shadow-[0_0_0_3px_rgba(251,168,3,0.15)] transition-all"
        />
        <!-- Dropdown -->
        <ul id="addr-dropdown" class="hidden absolute z-50 mt-1 w-full bg-white border border-slate-200 rounded-2xl shadow-lg overflow-hidden max-h-72 overflow-y-auto"></ul>
        <!-- Ergebnis -->
        <div id="addr-result" class="hidden mt-4"></div>
      </div>
    </div>
  </section>

  <!-- Was ist eine LEG? -->
  <section class="section bg-slate-50">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="badge mb-4 inline-block">Hintergrund</span>
          <h2 class="mb-6">Was ist eine LEG?</h2>
          <p class="text-slate-500 leading-relaxed mb-4">
            Eine Lokale Elektrizitäts­gemeinschaft (LEG) verbindet Solar-Produzenten und Strom-Konsumenten
            im selben Quartier. Alle Teilnehmenden sind am gleichen Transformatoren­station angeschlossen
            und tauschen Strom direkt untereinander aus – vermittelt durch den Netzbetreiber EKZ.
          </p>
          <p class="text-slate-500 leading-relaxed mb-4">
            Der Verein solarbonstetten übernimmt <strong class="text-slate-700">kostenlos</strong> die Verwaltung der LEGs in Bonstetten: Wir koordinieren
            die Anmeldungen, vertreten die Gemeinschaft gegenüber EKZ und kümmern uns um die jährliche Abrechnung.
          </p>
          <p class="text-slate-500 leading-relaxed">
            Es sind bis zu <strong class="text-slate-700">{zonen.length} LEGs</strong> in Bonstetten geplant.
            Jede LEG wird gegründet, sobald sich genug Interessentinnen und Interessenten aus dem jeweiligen Quartier angemeldet haben.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <h3 class="text-base font-bold text-slate-900 mb-3">Für Konsumentinnen &amp; Konsumenten</h3>
            <ul class="flex flex-col gap-2 text-sm text-slate-500">
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Stabiler LEG-Energiepreis von {LEG_ENERGIE} Rp./kWh – das ganze Jahr gleich</li>
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Lokaler Solarstrom ohne Aufpreis – unter dem Strich nicht teurer als der EKZ-Standardtarif, im Winter günstiger</li>
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Restliche Energie weiterhin via EKZ geliefert</li>
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Kein Zusatzaufwand – jährliche Abrechnung</li>
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Austritt mit 3 Monaten Frist jederzeit möglich</li>
            </ul>
          </div>
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
            <h3 class="text-base font-bold text-slate-900 mb-3">Für Produzentinnen &amp; Produzenten</h3>
            <ul class="flex flex-col gap-2 text-sm text-slate-500">
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Stabile Vergütung von {LEG_ENERGIE} Rp./kWh für LEG-Strom – unabhängig vom Spot-Marktpreis</li>
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Direkter Verkauf im Quartier statt Einspeisung</li>
              <li class="flex items-start gap-2"><span class="text-amber-500 font-bold shrink-0">✓</span> Verwaltung durch solarbonstetten</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- So funktioniert's -->
  <section class="section">
    <div class="container">
      <div class="text-center mb-14">
        <h2 class="mb-4">So funktioniert die Teilnahme</h2>
        <p class="text-lg text-slate-500 max-w-xl mx-auto">In drei Schritten zur lokalen Strom­gemeinschaft.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { nr: '1', titel: 'Interessieren &amp; Anmelden', text: 'Formular ausfüllen und Interesse bekunden. Je mehr Interessierte, desto schneller kann die LEG in deinem Quartier gegründet werden.' },
          { nr: '2', titel: 'LEG wird gegründet', text: 'Sobald sich genug Teilnehmende aus dem gleichen Trafokreis gemeldet haben, gründen wir die LEG und registrieren sie im EKZ-Portal.' },
          { nr: '3', titel: 'Strom tauschen &amp; profitieren', text: 'Ab Aktivierung fliesst lokaler Solarstrom direkt zu dir. Die Abrechnung erfolgt jährlich – automatisch durch solarbonstetten.' },
        ].map(s => (
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-8 flex flex-col gap-4">
            <span class="w-12 h-12 bg-amber-400 text-white font-bold text-xl rounded-full flex items-center justify-center">{s.nr}</span>
            <h3 class="text-base font-bold text-slate-900" set:html={s.titel} />
            <p class="text-sm text-slate-500 leading-relaxed">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 13 LEG-Zonen -->
  <section class="section bg-slate-50 scroll-mt-20" id="leg-zonen">
    <div class="container">
      <div class="text-center mb-14">
        <span class="badge mb-4 inline-block">Bonstetten</span>
        <h2 class="mb-4">Die {zonen.length} LEG-Zonen</h2>
        <p class="text-lg text-slate-500 max-w-xl mx-auto">
          Jede Zone entspricht einem Trafokreis. Du kannst dich für die Zone anmelden,
          in der dein Gebäude liegt – oder «Noch nicht sicher» wählen.
        </p>
      </div>
      <!-- Karte -->
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm mb-8" style="height: 500px;">
        <iframe
          src="/leg/legmap.html"
          width="100%"
          height="100%"
          style="border: none; display: block;"
          title="LEG-Zonen Karte Bonstetten"
        ></iframe>
      </div>

      <!-- Status-Legende -->
      <div class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs text-slate-500 mb-6">
        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-300"></span> Geplant</span>
        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-400"></span> In Erfassung</span>
        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-blue-500"></span> Angemeldet bei EKZ</span>
        <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-green-500"></span> Aktiv</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" id="zonen-grid">
        {zonen.map((zone, i) => (
          <div
            class="zone-card bg-white rounded-xl border-2 border-slate-100 shadow-sm px-4 py-3 flex items-center gap-3 cursor-pointer transition-all hover:border-slate-300"
            data-leg-id={zone.legId}
            data-status={zone.status}
            style={`--zone-color: ${zone.color}`}
          >
            <span class="w-7 h-7 font-bold text-xs rounded-full flex items-center justify-center shrink-0 text-white" style={`background:${zone.color}`}>{i + 1}</span>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-slate-900 text-sm m-0 leading-tight">{zone.name}</p>
              <p class={`text-[10px] m-0 mt-0.5 flex items-center gap-1 uppercase tracking-wider font-semibold ${statusMeta[zone.status].textClass}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${statusMeta[zone.status].dotClass}`}></span>
                {statusMeta[zone.status].label}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Voraussetzungen + Bedingungen -->
  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="mb-6">Voraussetzungen</h2>
          <ul class="flex flex-col gap-4">
            {[
              { icon: '📡', titel: 'Kommunikativer Smart Meter', text: 'Dein Stromanschluss benötigt einen intelligenten Zähler, der Daten aktiv an EKZ übermittelt. Falls noch nicht vorhanden, wird er von EKZ installiert – das kann die Aktivierungsfrist auf 3 Monate verlängern.' },
              { icon: '🗺️', titel: 'Gleiche LEG-Zone', text: 'Alle Mitglieder einer LEG müssen in der gleichen Zone liegen – die Zonen entsprechen den Trafokreisen der EKZ und sind auf der Karte oben eingezeichnet.' },
              { icon: '☀️', titel: 'Mindest-Solaranteil', text: 'Die Solarleistung der LEG muss mindestens 5% der Anschlussleistung aller teilnehmenden Verbraucher betragen.' },
              { icon: '📋', titel: 'Teilnahmebedingungen', text: 'Alle Teilnehmenden akzeptieren die Teilnahmebedingungen von solarbonstetten. Du findest sie im untenstehenden Dokument.' },
            ].map(v => (
              <li class="flex items-start gap-4">
                <span class="text-2xl shrink-0">{v.icon}</span>
                <div>
                  <p class="font-semibold text-slate-900 text-sm mb-1">{v.titel}</p>
                  <p class="text-sm text-slate-500 leading-relaxed">{v.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="mb-6">Preismodell</h2>
          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 mb-6">
            <h3 class="text-base font-bold text-slate-900 mb-4">LEG-Energiepreis Bonstetten</h3>
            <div class="bg-white border-2 border-amber-400 rounded-xl px-4 py-3">
              <p class="text-xs text-amber-600 uppercase tracking-wider font-semibold mb-0.5">Für Konsumenten und Produzenten</p>
              <div class="flex items-center gap-3 flex-wrap">
                <p class="text-3xl font-bold text-amber-700 m-0">{LEG_ENERGIE} Rp.</p>
                <span class="bg-amber-400 text-white text-xs font-bold uppercase tracking-wider rounded-full px-3 py-1">nur Energie</span>
              </div>
              <p class="text-xs text-slate-400">pro kWh LEG-Strom – stabil, das ganze Jahr</p>
            </div>
            <!-- Was dazukommt -->
            <div class="flex items-center gap-3 px-4 py-2 text-slate-400">
              <span class="text-xl font-bold leading-none">+</span>
              <span class="text-xs uppercase tracking-wider font-semibold">für Konsumenten zusätzlich</span>
            </div>
            <div class="bg-slate-100 rounded-xl px-4 py-3 mb-2 flex items-center justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-slate-700 m-0">Netznutzung &amp; Abgaben</p>
                <p class="text-xs text-slate-400 m-0">von EKZ verrechnet – Netznutzung mit 40% Rabatt</p>
              </div>
              <p class="text-lg font-semibold text-slate-600 m-0 whitespace-nowrap tabular-nums">{rp(preisTabellen[0].total.leg - LEG_ENERGIE)} Rp.</p>
            </div>
            <div class="flex items-center justify-between gap-3 px-4 mb-4">
              <p class="text-sm font-bold text-slate-900 m-0">Total pro kWh LEG-Strom ({preisTabellen[0].jahr})</p>
              <p class="text-lg font-bold text-slate-900 m-0 whitespace-nowrap tabular-nums">{rp(preisTabellen[0].total.leg)} Rp.</p>
            </div>
            <p class="text-xs mb-3"><a href="#preise" class="text-amber-700 font-semibold underline">Zur detaillierten Preisübersicht ↓</a></p>
            <div class="flex flex-col gap-1.5">
              <p class="text-xs text-slate-500 leading-relaxed">
                Konsumenten bezahlen {LEG_ENERGIE} Rp./kWh für die Energie, Produzenten erhalten {LEG_ENERGIE} Rp./kWh –
                die Einnahmen gehen vollständig an die Solarstromproduzenten der LEG.
              </p>
              <p class="text-xs text-slate-500 leading-relaxed">
                Unser Ziel ist ein stabiler Preis. Allfällige Preisanpassungen kündigen wir mindestens
                drei Monate im Voraus an (Teilnahmebedingungen Ziff. 5.4).
              </p>
              <p class="text-xs text-slate-500 leading-relaxed">
                Netznutzung und Abgaben verrechnet weiterhin EKZ. Nicht abgedeckten Restbedarf liefert EKZ
                zum gewohnten Tarif – die Versorgung ist jederzeit sichergestellt.
              </p>
            </div>
          </div>
          <div class="bg-white border border-slate-200 rounded-2xl p-6">
            <h3 class="text-base font-bold text-slate-900 mb-2">Ein- &amp; Austritt</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              Der Eintritt in eine LEG ist nach Aktivierung (ca. 3 Monate nach Gründung) möglich.
              Der Austritt ist mit <strong class="text-slate-700">3 Monaten Frist</strong> auf Monatsende jederzeit möglich.
            </p>
          </div>

          <!-- Dokument -->
          <div class="flex items-center gap-4 bg-slate-50 border border-slate-200 rounded-xl px-5 py-4 mt-4">
            <span class="text-2xl shrink-0">📄</span>
            <div class="flex-1 min-w-0">
              <strong class="block text-sm text-slate-900 mb-0.5">LEG-Teilnahmebedingungen</strong>
              <p class="text-xs text-slate-500 m-0">Bedingungen für die Teilnahme an einer LEG von solarbonstetten.</p>
            </div>
            <a href={`${base}/dokumente/Teilnahmebedingungen_LEG_solarbonstetten_v1.3.pdf`}
               target="_blank" rel="noopener noreferrer"
               class="btn btn-outline text-sm shrink-0">PDF ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Was bezahle ich effektiv? -->
  <section class="section bg-slate-50 scroll-mt-20" id="preise">
    <div class="container max-w-4xl">
      <div class="text-center mb-10">
        <span class="badge mb-4 inline-block">Preisübersicht</span>
        <h2 class="mb-4">Was bezahle ich effektiv?</h2>
        <p class="text-slate-500 leading-relaxed max-w-2xl mx-auto">
          Der Strompreis besteht aus Energie, Netznutzung und Abgaben. In der LEG ändert sich die Energie
          ({LEG_ENERGIE} Rp./kWh an die LEG) und die Netznutzung (40% Rabatt) – alles andere bleibt bei EKZ.
        </p>
      </div>

      {preisTabellen.map((t, i) => (
        <details class="preis-details bg-white rounded-2xl border border-slate-200 shadow-sm mb-4 overflow-hidden" open={i === 0}>
          <summary class="cursor-pointer px-5 py-4 font-bold text-slate-900 text-sm flex items-center justify-between">
            <span>Konsumenten – Tarife {t.jahr}</span>
            <span class="text-xs font-normal text-slate-400">Rp./kWh inkl. MWST</span>
          </summary>
          <div class="overflow-x-auto border-t border-slate-100">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-xs uppercase tracking-wider text-slate-400">
                  <th class="text-left font-semibold px-5 py-3"></th>
                  <th class="text-right font-semibold px-4 py-3 bg-amber-50 text-amber-700 whitespace-nowrap">LEG-Strom</th>
                  <th class="text-right font-semibold px-4 py-3 whitespace-nowrap">EKZ Winter<br /><span class="normal-case tracking-normal font-normal">Okt.–März</span></th>
                  <th class="text-right font-semibold px-4 py-3 whitespace-nowrap">EKZ Sommer<br /><span class="normal-case tracking-normal font-normal">Apr.–Sept.</span></th>
                </tr>
              </thead>
              <tbody>
                {t.zeilen.map(z => (
                  <tr class="border-t border-slate-100">
                    <td class="px-5 py-3">
                      <span class="font-semibold text-slate-900">{z.label}</span>
                      <span class="block text-xs text-slate-400">{z.hinweis}</span>
                    </td>
                    <td class="text-right px-4 py-3 bg-amber-50 font-semibold text-amber-700 tabular-nums">{rp(z.leg)}</td>
                    <td class="text-right px-4 py-3 text-slate-600 tabular-nums">{rp(z.winter)}</td>
                    <td class="text-right px-4 py-3 text-slate-600 tabular-nums">{rp(z.sommer)}</td>
                  </tr>
                ))}
                <tr class="border-t-2 border-slate-200 font-bold">
                  <td class="px-5 py-3 text-slate-900">Total pro kWh</td>
                  <td class="text-right px-4 py-3 bg-amber-50 text-amber-700 tabular-nums">{rp(t.total.leg)}</td>
                  <td class="text-right px-4 py-3 text-slate-900 tabular-nums">{rp(t.total.winter)}</td>
                  <td class="text-right px-4 py-3 text-slate-900 tabular-nums">{rp(t.total.sommer)}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed px-5 py-3 border-t border-slate-100 m-0">
            EKZ-Standardtarif (EKZ Energie Erneuerbar, EKZ Netz 400ST). Im Basistarif (EKZ Netz 400F) liegt das Total
            für LEG-Strom {rp(t.basisDiff)} Rp. und für EKZ-Strom {rp(t.basisDiffEkz)} Rp. tiefer.
            Grund- und Messtarif von EKZ bleiben unverändert.
          </p>
        </details>
      ))}

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <p class="px-5 py-4 font-bold text-slate-900 text-sm m-0 flex items-center justify-between">
          <span>Produzenten – Vergütung ab 2027</span>
          <span class="text-xs font-normal text-slate-400">Rp./kWh</span>
        </p>
        <div class="overflow-x-auto border-t border-slate-100">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-xs uppercase tracking-wider text-slate-400">
                <th class="text-left font-semibold px-5 py-3"></th>
                <th class="text-right font-semibold px-4 py-3 bg-amber-50 text-amber-700 whitespace-nowrap">Verkauf in der LEG</th>
                <th class="text-right font-semibold px-4 py-3 whitespace-nowrap">Rücklieferung an EKZ</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-5 py-3 font-semibold text-slate-900">Energie</td>
                <td class="text-right px-4 py-3 bg-amber-50 font-semibold text-amber-700 whitespace-nowrap">{rp(LEG_ENERGIE)}</td>
                <td class="text-right px-4 py-3 text-slate-600">Spot-Marktpreis<span class="block text-xs text-slate-400">mind. 6.00 im Quartalsmittel (Anlagen bis 30 kW)</span></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-5 py-3 font-semibold text-slate-900">Herkunftsnachweis (HKN)</td>
                <td class="text-right px-4 py-3 bg-amber-50 text-amber-700">–</td>
                <td class="text-right px-4 py-3 text-slate-600">bis 3.00 im Winter<span class="block text-xs text-slate-400">bis 0.50 im Sommer</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed px-5 py-3 border-t border-slate-100 m-0">
          Strom, der in der LEG keinen Abnehmer findet, wird weiterhin zum EKZ-Rückliefertarif vergütet.
          Ab 2027 richtet sich dieser nach dem viertelstündlichen Spot-Marktpreis und kann auch negativ sein.
        </p>
      </div>

      <p class="text-xs text-slate-400 text-center mt-6">
        Quelle EKZ-Tarife: <a href="https://www.ekz.ch/de/angebote/strom/tarife/stromtarife-privatkunden.html" target="_blank" rel="noopener noreferrer" class="underline">Tarife für Privatkunden</a>
        und <a href="https://www.ekz.ch/de/angebote/strom/tarife/rueckliefertarife.html" target="_blank" rel="noopener noreferrer" class="underline">Rückliefertarife</a>. Alle Angaben ohne Gewähr.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-amber-400">
    <div class="container text-center">
      <h2 class="mb-4 text-white">Interesse? Jetzt anmelden!</h2>
      <p class="text-white/90 text-lg max-w-xl mx-auto mb-8 leading-relaxed">
        Melde dich an – sobald sich genug Interessierte in deinem Quartier gefunden haben, gründen wir die LEG.
      </p>
      <a href={`${base}/leg/anmeldung`} class="btn bg-white text-amber-700 hover:bg-amber-50 font-bold px-8 py-4 text-base">
        Zur Anmeldung →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .zone-card.active {
    border-color: var(--zone-color) !important;
    background-color: color-mix(in srgb, var(--zone-color) 10%, white);
  }
</style>

<script define:vars={{ zonen }}>
  const iframe = document.querySelector('iframe[title="LEG-Zonen Karte Bonstetten"]');
  const cards = document.querySelectorAll('.zone-card');

  // Card click → select zone on map
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const legId = parseInt(card.dataset.legId ?? '-1');
      const isAlreadyActive = card.classList.contains('active');

      cards.forEach(c => c.classList.remove('active'));

      if (!isAlreadyActive) {
        card.classList.add('active');
        iframe?.contentWindow?.postMessage({ type: 'selectLeg', legId }, '*');
      } else {
        iframe?.contentWindow?.postMessage({ type: 'selectLeg', legId: -1 }, '*');
      }
    });
  });

  // Map click → highlight matching card
  window.addEventListener('message', (event) => {
    if (event.data?.type !== 'legSelected') return;
    const legId = event.data.legId;
    cards.forEach(card => {
      card.classList.toggle('active', parseInt(card.dataset.legId ?? '-1') === legId && legId !== -1);
    });
    // Scroll active card into view
    const active = document.querySelector('.zone-card.active');
    if (active) active.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  // ── Address-Lookup ──────────────────────────────────────────
  const searchInput = document.getElementById('addr-search');
  const dropdown    = document.getElementById('addr-dropdown');
  const resultBox   = document.getElementById('addr-result');

  let addresses = null; // lazy loaded

  async function loadAddresses() {
    if (addresses) return addresses;
    const res = await fetch('/leg/data/addresses.json');
    addresses = await res.json();
    return addresses;
  }

  function selectAddress(entry) {
    // Close dropdown
    dropdown.innerHTML = '';
    dropdown.classList.add('hidden');
    searchInput.value = entry.address;

    // Lookup zone
    const legId = entry.leg_index !== null ? entry.leg_index + 1 : null;
    const zone  = legId !== null ? zonen.find(z => z.legId === legId) : null;

    // Show result
    if (zone) {
      resultBox.innerHTML = `
        <div class="flex items-center gap-4 bg-white border-2 rounded-2xl px-5 py-4" style="border-color: ${zone.color}">
          <span class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 text-white font-bold text-sm" style="background:${zone.color}">
            ${zonen.indexOf(zone) + 1}
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-slate-400 uppercase tracking-wider mb-0.5">Deine LEG-Zone</p>
            <p class="font-bold text-slate-900 text-base m-0">${zone.name}</p>
          </div>
          <a href="#leg-zonen" class="btn btn-outline text-sm shrink-0" id="zone-link">Zur Zone →</a>
        </div>`;
      resultBox.classList.remove('hidden');

      // Highlight zone card
      cards.forEach(c => c.classList.toggle('active', parseInt(c.dataset.legId ?? '-1') === legId));

      // "Zur Zone" button: intercept click to also trigger map zoom after scroll
      document.getElementById('zone-link')?.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('leg-zonen')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => {
          iframe?.contentWindow?.postMessage({ type: 'selectLeg', legId }, '*');
        }, 600);
        setTimeout(() => {
          iframe?.contentWindow?.postMessage({ type: 'selectAddress', address: entry.address }, '*');
        }, 1500);
      });

      // Scroll to map, then zone zoom, then popup after zone animation
      document.getElementById('leg-zonen')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => {
        iframe?.contentWindow?.postMessage({ type: 'selectLeg', legId }, '*');
      }, 600);
      setTimeout(() => {
        iframe?.contentWindow?.postMessage({ type: 'selectAddress', address: entry.address }, '*');
      }, 1500);
    } else {
      resultBox.innerHTML = `
        <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 rounded-2xl px-5 py-4 text-slate-500 text-sm">
          <span class="text-xl">🔍</span>
          <span>Diese Adresse liegt nicht in einer der ${zonen.length} LEG-Zonen in Bonstetten.</span>
        </div>`;
      resultBox.classList.remove('hidden');
      // Reset map + cards
      cards.forEach(c => c.classList.remove('active'));
      iframe?.contentWindow?.postMessage({ type: 'selectLeg', legId: -1 }, '*');
    }
  }

  searchInput?.addEventListener('input', async () => {
    const q = searchInput.value.trim().toLowerCase();
    resultBox.classList.add('hidden');
    resultBox.innerHTML = '';

    if (q.length < 2) {
      dropdown.innerHTML = '';
      dropdown.classList.add('hidden');
      return;
    }

    const data = await loadAddresses();
    const hits = data.filter(e => e.address.toLowerCase().includes(q)).slice(0, 8);

    if (hits.length === 0) {
      dropdown.innerHTML = '';
      dropdown.classList.add('hidden');
      return;
    }

    dropdown.innerHTML = hits.map((e, i) =>
      `<li class="addr-option px-5 py-3 cursor-pointer hover:bg-amber-50 text-sm text-slate-700 border-b border-slate-100 last:border-0" data-idx="${i}">${e.address}</li>`
    ).join('');
    dropdown.classList.remove('hidden');

    dropdown.querySelectorAll('.addr-option').forEach((li, i) => {
      li.addEventListener('click', () => selectAddress(hits[i]));
    });
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    if (!document.getElementById('lookup-wrapper')?.contains(e.target)) {
      dropdown.classList.add('hidden');
    }
  });

  // Reset when input is cleared
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const firstItem = dropdown.querySelector('.addr-option');
      if (firstItem) firstItem.click();
    }
  });

  searchInput?.addEventListener('search', () => {
    if (!searchInput.value) {
      dropdown.classList.add('hidden');
      resultBox.classList.add('hidden');
      cards.forEach(c => c.classList.remove('active'));
      iframe?.contentWindow?.postMessage({ type: 'selectLeg', legId: -1 }, '*');
    }
  });
</script>
