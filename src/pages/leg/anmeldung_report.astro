        <label class="text-sm font-medium text-slate-900">Adresse des Messpunkts (optional)</label>
        <input type="text" class="input-field mp-addr" placeholder="Nur falls abweichend von deiner Adresse" autocomplete="off" />
      </div>
    </div>
    <div class="text-right mt-3">
      <button type="button" class="mp-remove text-xs text-slate-400 hover:text-red-600 underline">Messpunkt entfernen</button>
