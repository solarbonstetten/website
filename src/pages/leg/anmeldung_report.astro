let pdfFile = null;
let selectedMps = new Set();
// { message, phase } when the PDF could not be read
let parseFailure = null;
let lastPhase = "";

// Failures we do not catch ourselves (worker crashes, blocked scripts) so that
// they end up in the diagnostics attached to a manual submission.
const collectedErrors = [];
function noteError(kind, detail) {
  const entry = `${kind}: ${String(detail).slice(0, 300)}`;
  if (!collectedErrors.includes(entry)) collectedErrors.push(entry);
  if (collectedErrors.length > 6) collectedErrors.shift();
}
window.addEventListener("error", (e) => {
  noteError("window.error", e.message || `Ressource konnte nicht geladen werden: ${e.filename || "?"}`);
});
window.addEventListener("unhandledrejection", (e) => {
  noteError("unhandledrejection", e.reason?.message || e.reason);
});

function setStatus(msg) {
  statusText.textContent = msg || "";
  statusEl.hidden = !msg;
}
function showError(msg) { errorBox.textContent = msg; errorBox.hidden = false; }
function clearError() { errorBox.hidden = true; errorBox.textContent = ""; }

function buildDiagnostics() {
  const lines = [
    `Datei: ${pdfFile?.name || "?"} (${pdfFile?.size ?? "?"} Bytes, Typ ${pdfFile?.type || "unbekannt"})`,
    `Fehler: ${parseFailure?.message || "?"}`,
    `Phase: ${parseFailure?.phase || "–"}`,
    `pdf.js: ${pdfjsVersion}${globalThis.pdfjsWorker ? " (ohne Web Worker)" : ""}`,
    `Fehlende Funktionen: ${missingFeatures === null
      ? "nicht geprüft"
      : (missingFeatures.length ? missingFeatures.join(", ") : "keine")}`,
    `Web Worker: ${typeof Worker === "undefined" ? "nicht verfügbar" : "verfügbar"}`,
    `Browser: ${navigator.userAgent}`,
  ];
  for (const err of collectedErrors) lines.push(err);
  return lines.join("\n");
}

function escHtml(s) {
  return String(s).replace(/[&<>"']/g, c =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
}

function zoneOptionsHtml(selectedZone) {
  return legsData.map(l => {
    const sel = l.name === selectedZone ? "selected" : "";
    const emoji = statusEmoji[l.status || "geplant"] || "";
    return `<option value="${escHtml(l.name)}" ${sel}>${emoji} ${escHtml(l.name)}</option>`;
  }).join("");
}

function renderMpCards(report) {
  mpList.innerHTML = "";
  selectedMps.clear();

  report.measuring_points.forEach((mp, i) => {
    selectedMps.add(i);
    const role = inferRole(mp);
    const zones = detectZone(mp.adresse);
    const zoneMatch = zones.length === 1 ? zones[0] : null;

    const card = document.createElement("label");
    card.className = "mp-card selected block";

    const addr = mp.adresse
      ? [mp.adresse.strasse, [mp.adresse.plz, mp.adresse.ort].filter(Boolean).join(" ")].filter(Boolean).join(", ")
      : "Adresse unbekannt";

    const roleBadge = role === "Produzent"
      ? `<span class="mp-badge mp-badge-producer">Produzent</span>`
      : `<span class="mp-badge mp-badge-consumer">Konsument</span>`;

    let zoneBadgeHtml;
    if (zoneMatch) {
      zoneBadgeHtml = `<span class="mp-badge mp-badge-zone mp-zone-badge">${escHtml(zoneMatch)}</span>`;
    } else if (zones.length > 1) {
      zoneBadgeHtml = `<span class="mp-badge mp-badge-zone-unknown mp-zone-badge">Mehrere Zonen möglich</span>`;
    } else {
      zoneBadgeHtml = `<span class="mp-badge mp-badge-zone-unknown mp-zone-badge">Zone nicht erkannt</span>`;
    }

    // Zone select dropdown (for manual override or when ambiguous)
    const zoneOptions = zoneOptionsHtml(zoneMatch);

    card.innerHTML = `
      <div class="flex items-start gap-3">
        <input type="checkbox" class="mp-check w-4 h-4 mt-1 accent-amber-400 shrink-0 cursor-pointer" data-index="${i}" checked />
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap mb-1">
            <span class="font-mono text-xs text-slate-400">${escHtml(mp.messpunkt_id || "ID unbekannt")}</span>
            ${roleBadge}
            ${zoneBadgeHtml}
          </div>
          <div class="text-sm text-slate-700">${escHtml(addr)}</div>
          <div class="mt-2">
            <label class="text-xs text-slate-500">LEG-Zone:
              <select class="mp-zone-select input-field text-xs py-1 px-2 mt-0.5" data-index="${i}" style="max-width:220px">
                <option value="">Bitte wählen…</option>
                ${zoneOptions}
              </select>
            </label>
          </div>
          <div class="mt-2 text-xs text-slate-400">
            Netzebene: ${mp.netzebene ?? "–"} ·
            ${mp.anschlussleistung?.kw != null ? `${mp.anschlussleistung.kw} kW` : "–"} ·
            Unterwerk: ${escHtml(mp.unterwerk?.name || "–")} ·
            Trafo: ${escHtml(mp.trafostation?.name || "–")}
          </div>
        </div>
      </div>
    `;

    const checkbox = card.querySelector(".mp-check");
    checkbox.addEventListener("change", () => {
      if (checkbox.checked) {
        selectedMps.add(i);
        card.classList.add("selected");
      } else {
        selectedMps.delete(i);
        card.classList.remove("selected");
      }
    });

    const zoneSelect = card.querySelector(".mp-zone-select");
    const zoneBadge = card.querySelector(".mp-zone-badge");
    zoneSelect.addEventListener("change", () => {
      if (zoneSelect.value) {
        zoneBadge.textContent = zoneSelect.value;
        zoneBadge.className = "mp-badge mp-badge-zone mp-zone-badge";
      } else {
        zoneBadge.textContent = "Zone nicht erkannt";
        zoneBadge.className = "mp-badge mp-badge-zone-unknown mp-zone-badge";
      }
    });

    mpList.appendChild(card);
  });
}

function prefillForm(report) {
  const c = report.customer;
  const nameField = document.getElementById("name");
  const strasseField = document.getElementById("strasse");
  const plzField = document.getElementById("plz");
