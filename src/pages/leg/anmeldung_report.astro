---
import BaseLayout from '../../layouts/BaseLayout.astro';
import legsData from '../../../public/leg/data/legs.json';
import pdfjsPkg from 'pdfjs-dist/package.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// pdf.js is served from our own origin (see scripts/vendor-pdfjs.mjs)
const pdfjsBase = `${base}/leg/pdfjs`;
const pdfjsVersion = pdfjsPkg.version;
const zonen = legsData.map(l => ({ name: l.name, status: l.status || 'geplant' }));

const statusEmoji: Record<string, string> = {
  geplant:    '⚪',
  erfassung:  '🟡',
  angemeldet: '🔵',
  aktiv:      '🟢',
};
---
<BaseLayout
  title="LEG Anmeldung (mit PDF)"
  description="Melde dich für eine Lokale Elektrizitätsgemeinschaft (LEG) in Bonstetten an – lade dein Anlageninformations-PDF hoch und wir füllen das Formular für dich aus."
>

  <!-- Hero -->
  <div class="relative overflow-hidden" style="padding: 11rem 0 5rem">
    <div class="hero-bg-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
    </div>
    <div class="container">
      <span class="badge">LEG Bonstetten</span>
      <h1 class="mb-4">Anmeldung LEG</h1>
      <p class="text-lg text-slate-500 max-w-xl leading-relaxed">
        Lade dein <a href="https://my.ekz.ch/leg-anlageninformationen/" target="_blank" rel="noopener noreferrer" class="text-amber-700 hover:underline">Anlageninformations-PDF aus dem myEKZ-Portal</a> hoch – wir füllen das Formular automatisch für dich aus.
      </p>
    </div>
  </div>

  <!-- Content -->
  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-12 items-start">

        <div>
          <!-- Phase 1: Upload -->
          <div id="upload-phase">

            <!-- Collapsible guide -->
            <details class="border border-slate-200 rounded-2xl mb-6 overflow-hidden">
              <summary class="px-7 py-5 cursor-pointer text-sm font-semibold text-slate-900 hover:bg-slate-50 transition-colors">
                Wo finde ich das Anlageninformations-PDF?
              </summary>
              <div class="px-7 pb-6">
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  Öffne die Seite <a href="https://my.ekz.ch/leg-anlageninformationen/" target="_blank" rel="noopener noreferrer" class="text-amber-700 underline font-semibold hover:text-amber-900">Anlageninformationen im myEKZ-Portal →</a> und lade das PDF herunter.
                  Alternativ: Melde dich auf <a href="https://www.myekz.ch" target="_blank" rel="noopener noreferrer" class="text-amber-700 hover:underline">myEKZ.ch</a> an und navigiere zu <strong>«Solar»</strong> → <strong>«Anlageninformationen»</strong>.
                </p>
                <img
                  src={`${base}/leg/guide/myekz_export_animation.gif`}
                  alt="Anleitung: So findest du das Anlageninformations-PDF im myEKZ-Portal"
                  class="rounded-xl border border-slate-200 w-full max-w-lg"
                  loading="lazy"
                />
                <p class="text-xs text-slate-400 mt-3">
                  Noch kein myEKZ-Konto?
                  <a href="https://www.ekz.ch/de/kundenservice/self-service/myEKZ/registrierung-leg.html"
                     target="_blank" rel="noopener noreferrer"
                     class="text-amber-700 hover:underline">Schritt-für-Schritt-Anleitung von EKZ →</a>
                </p>
              </div>
            </details>

            <!-- Dropzone -->
            <div id="dropzone" class="border-2 border-dashed border-slate-300 rounded-2xl p-12 text-center bg-white cursor-pointer transition-all hover:border-amber-400">
              <div class="text-4xl mb-3">📄</div>
              <p class="font-semibold text-slate-900 mb-1">PDF hierher ziehen oder klicken</p>
              <p class="text-sm text-slate-400 mb-4">Die Verarbeitung erfolgt vollständig im Browser – es wird nichts hochgeladen.</p>
              <button type="button" id="chooseBtn" class="btn btn-primary">Datei auswählen</button>
              <input type="file" id="fileInput" accept="application/pdf,.pdf" class="hidden" />
            </div>

            <div id="status" class="mt-3 text-sm text-slate-500 flex items-center gap-2" hidden>
              <span class="spinner" aria-hidden="true"></span>
              <span id="status-text"></span>
            </div>
            <div id="errorBox" class="mt-3 bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-red-600 text-sm" hidden></div>
          </div>

          <!-- Phase 2: Form (hidden until PDF parsed) -->
          <form id="legform" novalidate class="flex flex-col gap-8" hidden>

            <!-- Fehlermeldung, wenn das PDF nicht gelesen werden konnte -->
            <div id="manual-notice" class="bg-red-50 border border-red-200 rounded-2xl px-5 py-4" hidden>
              <p class="text-sm text-red-800 leading-relaxed m-0">
                Leider ist beim Verarbeiten des PDF ein Fehler aufgetreten:
                <strong id="manual-notice-msg"></strong>
              </p>
              <p class="text-sm text-red-800 leading-relaxed mt-2 mb-0">
                Kein Problem – bitte fülle die Angaben unten selber aus. Dein PDF wird mitgeschickt,
                wir erfassen die Anmeldung dann von Hand.
              </p>
              <details class="mt-3">
                <summary class="text-xs text-red-700 cursor-pointer">Technische Details (werden mitgeschickt)</summary>
                <pre id="manual-diagnostics" class="text-xs text-red-700 whitespace-pre-wrap break-words mt-2 mb-0 font-mono"></pre>
              </details>
            </div>

            <!-- Datei-Info -->
            <div id="file-info" class="flex items-center justify-between gap-4 bg-green-50 border border-green-200 rounded-xl px-5 py-3">
              <span id="parsed-filename" class="text-sm text-green-800 font-medium"></span>
              <button type="button" id="resetBtn" class="text-sm text-green-700 hover:text-green-900 underline shrink-0">Andere Datei laden</button>
            </div>

            <!-- Messpunkt-Auswahl -->
            <fieldset class="border border-slate-200 rounded-2xl px-7 py-6">
              <legend id="mp-legend" class="text-xs font-bold uppercase tracking-widest text-slate-900 px-2">Messpunkte auswählen</legend>
              <p id="mp-hint" class="text-sm text-slate-500 mt-2 mb-4">
                Wähle die Messpunkte aus, die du für die LEG anmelden möchtest.
                Die Rolle (Konsument/Produzent) und LEG-Zone wurden automatisch erkannt.
              </p>
              <div id="mp-list" class="flex flex-col gap-3"></div>
              <button type="button" id="addMpBtn" class="mt-3 text-sm text-amber-700 hover:text-amber-900 font-semibold" hidden>
                + Weiteren Messpunkt hinzufügen
              </button>
            </fieldset>

            <!-- Art der Meldung -->
            <fieldset class="border border-slate-200 rounded-2xl px-7 py-6">
              <legend class="text-xs font-bold uppercase tracking-widest text-slate-900 px-2">Art der Meldung</legend>
              <div class="grid grid-cols-2 gap-4 mt-4 max-sm:grid-cols-1">
                <label class="cursor-pointer h-full flex flex-col">
                  <input type="radio" name="art" value="Anmeldung" required class="sr-only peer" checked />
                  <div class="border-2 border-slate-200 rounded-xl p-4 transition-all hover:border-amber-400 peer-checked:border-amber-400 peer-checked:bg-amber-50 flex-1">
                    <span class="font-semibold text-slate-900 text-sm block mb-1">Anmeldung</span>
                    <p class="text-xs text-slate-500 m-0">Ich möchte an einer LEG teilnehmen</p>
                  </div>
                </label>
                <label class="cursor-pointer h-full flex flex-col">
                  <input type="radio" name="art" value="Abmeldung" class="sr-only peer" />
                  <div class="border-2 border-slate-200 rounded-xl p-4 transition-all hover:border-amber-400 peer-checked:border-amber-400 peer-checked:bg-amber-50 flex-1">
                    <span class="font-semibold text-slate-900 text-sm block mb-1">Abmeldung</span>
                    <p class="text-xs text-slate-500 m-0">Ich möchte aus einer LEG austreten</p>
                  </div>
                </label>
              </div>
            </fieldset>

            <!-- Persönliche Angaben (pre-filled) -->
            <fieldset class="border border-slate-200 rounded-2xl px-7 py-6">
              <legend class="text-xs font-bold uppercase tracking-widest text-slate-900 px-2">Persönliche Angaben</legend>
              <p id="person-hint" class="text-xs text-slate-400 mt-2 mb-3">Aus dem PDF übernommen – bitte überprüfen und ggf. korrigieren.</p>
              <div class="flex flex-col gap-1.5 mt-2">
                <label for="name" class="text-sm font-medium text-slate-900">Name <span class="text-amber-700">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" class="input-field" />
              </div>
              <div class="flex flex-col gap-1.5 mt-4">
                <label for="strasse" class="text-sm font-medium text-slate-900">Strasse und Hausnummer <span class="text-amber-700">*</span></label>
                <input type="text" id="strasse" name="strasse" required autocomplete="street-address" class="input-field" />
              </div>
              <div class="grid grid-cols-[100px_1fr] gap-4 max-sm:grid-cols-1">
                <div class="flex flex-col gap-1.5 mt-4">
                  <label for="plz" class="text-sm font-medium text-slate-900">PLZ <span class="text-amber-700">*</span></label>
                  <input type="text" id="plz" name="plz" required autocomplete="postal-code" maxlength="4" class="input-field" />
                </div>
                <div class="flex flex-col gap-1.5 mt-4">
                  <label for="ort" class="text-sm font-medium text-slate-900">Ort <span class="text-amber-700">*</span></label>
                  <input type="text" id="ort" name="ort" required autocomplete="address-level2" class="input-field" />
                </div>
              </div>
            </fieldset>

            <!-- Kontakt -->
            <fieldset class="border border-slate-200 rounded-2xl px-7 py-6">
              <legend class="text-xs font-bold uppercase tracking-widest text-slate-900 px-2">Kontakt</legend>
              <div class="grid grid-cols-2 gap-4 max-sm:grid-cols-1">
                <div class="flex flex-col gap-1.5 mt-4">
                  <label for="email" class="text-sm font-medium text-slate-900">E-Mail <span class="text-amber-700">*</span></label>
                  <input type="email" id="email" name="email" required autocomplete="email" class="input-field" />
                </div>
                <div class="flex flex-col gap-1.5 mt-4">
                  <label for="telefon" class="text-sm font-medium text-slate-900">Telefon</label>
                  <input type="tel" id="telefon" name="telefon" autocomplete="tel" class="input-field" />
                </div>
              </div>
            </fieldset>

            <!-- Bestätigungen -->
            <fieldset class="border border-slate-200 rounded-2xl px-7 py-6">
              <legend class="text-xs font-bold uppercase tracking-widest text-slate-900 px-2">Bestätigungen</legend>
              <div class="flex flex-col gap-3 mt-4">
                <label class="flex items-start gap-3 cursor-pointer text-sm text-slate-600">
                  <input type="checkbox" id="smartmeter" name="smartmeter" required class="w-4 h-4 mt-0.5 accent-amber-400 shrink-0 cursor-pointer" />
                  <span>Ich nehme zur Kenntnis, dass ein <strong>kommunikativer Smart Meter</strong> Voraussetzung ist. Falls noch nicht vorhanden, wird er von EKZ installiert. <span class="text-amber-700">*</span></span>
                </label>
                <label class="flex items-start gap-3 cursor-pointer text-sm text-slate-600">
                  <input type="checkbox" id="bedingungen" name="bedingungen" required class="w-4 h-4 mt-0.5 accent-amber-400 shrink-0 cursor-pointer" />
                  <span>Ich akzeptiere die <a href={`${base}/dokumente/Teilnahmebedingungen_LEG_solarbonstetten_v1.3.pdf`}
                       target="_blank" rel="noopener noreferrer"
                       class="text-amber-700 hover:underline">LEG-Teilnahmebedingungen von solarbonstetten</a>.
                    <span class="text-amber-700">*</span>
                  </span>
                </label>
              </div>
            </fieldset>

            <!-- Bemerkungen -->
            <fieldset class="border border-slate-200 rounded-2xl px-7 py-6">
              <legend class="text-xs font-bold uppercase tracking-widest text-slate-900 px-2">Bemerkungen</legend>
              <div class="flex flex-col gap-1.5 mt-4">
                <label for="bemerkungen" class="text-sm font-medium text-slate-900">Fragen oder Anmerkungen (optional)</label>
                <textarea id="bemerkungen" name="bemerkungen" rows="4" maxlength="4000" class="input-field resize-y"></textarea>
              </div>
            </fieldset>

            <div id="form-error" class="bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-red-600 text-sm" hidden></div>

            <button type="submit" class="btn btn-primary w-full justify-center text-base py-4">
              Anmeldung absenden
            </button>
          </form>

          <!-- Phase 3: Result (hidden until submit) -->
          <div id="result-phase" hidden>
            <div id="result-success" hidden>
              <div class="bg-green-50 border border-green-200 rounded-2xl px-7 py-8 text-center">
                <div class="text-4xl mb-4">&#x2705;</div>
                <h2 class="text-xl font-bold text-green-900 mb-3">Anmeldung erhalten</h2>
                <p class="text-sm text-green-800 leading-relaxed max-w-md mx-auto mb-4">
                  Vielen Dank! Wir haben deine Anmeldung erhalten und werden sie so bald wie möglich bearbeiten.
                  Wenn alles passt, laden wir dich direkt über das myEKZ-Portal zur LEG ein –
                  du erhältst dazu eine E-Mail von EKZ.
                </p>
                <p class="text-xs text-green-700">
                  Bei Fragen erreichst du uns unter <a href="mailto:leg@solarbonstetten.ch" class="font-semibold underline">leg@solarbonstetten.ch</a>.
                </p>
              </div>
            </div>
            <div id="result-error" hidden>
              <div class="bg-red-50 border border-red-200 rounded-2xl px-7 py-8 text-center">
                <div class="text-4xl mb-4">&#x26A0;&#xFE0F;</div>
                <h2 class="text-xl font-bold text-red-900 mb-3">Etwas ist schiefgelaufen</h2>
                <p id="result-error-msg" class="text-sm text-red-800 leading-relaxed max-w-md mx-auto mb-4"></p>
                <button type="button" id="backToFormBtn" class="btn btn-primary">Zurück zum Formular</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="flex flex-col gap-5 lg:sticky top-24">

          <div class="bg-amber-400 text-white rounded-2xl p-6">
            <h3 class="text-base font-bold mb-4 text-white">So funktioniert es</h3>
            <ol class="list-none p-0 flex flex-col gap-2.5">
              {[
                'Anlageninformations-PDF aus myEKZ herunterladen',
                'PDF hier hochladen',
                'Angaben prüfen und ergänzen',
                'Absenden – fertig!',
              ].map((step, i) => (
                <li class="flex items-start gap-3 text-sm opacity-95">
                  <span class="w-6 h-6 bg-white/25 rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">{i + 1}</span>
                  {step}
                </li>
              ))}
            </ol>
          </div>

          <div class="bg-white border border-slate-200 shadow-sm rounded-2xl p-6">
            <h3 class="text-base font-bold mb-2 text-slate-900">Fragen?</h3>
            <p class="text-sm text-slate-500 leading-relaxed mb-3">Bei Fragen zur LEG erreichst du uns unter:</p>
            <a href="mailto:leg@solarbonstetten.ch" class="text-amber-700 font-semibold text-sm break-all">leg@solarbonstetten.ch</a>
          </div>

          <div class="bg-white border border-slate-200 shadow-sm rounded-2xl p-6">
            <h3 class="text-base font-bold mb-2 text-slate-900">Mehr zur LEG</h3>
            <p class="text-sm text-slate-500 leading-relaxed mb-3">Alle Infos, Zonen und Bedingungen auf der Übersichtsseite.</p>
            <a href={`${base}/leg`} class="text-amber-700 font-semibold text-sm hover:underline">LEG-Übersicht →</a>
          </div>

        </aside>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .input-field {
    width: 100%;
    padding: 0.6rem 0.875rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: 0.95rem;
    color: var(--color-secondary);
    background: #fff;
    transition: border-color 0.2s;
  }
  .input-field:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(251, 168, 3, 0.15);
  }
  .input-field.invalid { border-color: #ef4444; }
  select.input-field { cursor: pointer; }
  textarea.input-field { min-height: 100px; }

  #dropzone.dragover {
    border-color: var(--color-primary);
    background: rgba(251, 168, 3, 0.04);
  }

  .mp-card {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    transition: border-color 0.2s, background 0.2s;
    cursor: pointer;
  }
  .mp-card:hover { border-color: #fbbf24; }
  .mp-card.selected {
    border-color: #f59e0b;
    background: #fffbeb;
  }
  .mp-card.manual-row {
    cursor: default;
  }
  .mp-card.manual-row:hover { border-color: #e2e8f0; }
  .mp-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }
  .mp-badge-consumer {
    background: #dbeafe;
    color: #1e40af;
  }
  .mp-badge-producer {
    background: #fef3c7;
    color: #92400e;
  }
  .mp-badge-zone {
    background: #f1f5f9;
    color: #334155;
  }
  .mp-badge-zone-unknown {
    background: #fef2f2;
    color: #991b1b;
  }
  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid #e2e8f0;
    border-top-color: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .spinner { animation-duration: 3s; }
  }

  .prefilled-hint {
    font-size: 0.7rem;
    color: #94a3b8;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }
</style>

<script type="module" define:vars={{ legsData, statusEmoji, pdfjsBase, pdfjsVersion }}>
// =====================================================================
// PDF parsing logic (from leg_report_extractor prototype)
// =====================================================================

// A parse error we can show to the user as-is. `retryable` marks failures that
// look like a broken pdf.js setup (rather than an unexpected document), which
// is worth a second attempt without the Web Worker.
class LegReportParseError extends Error {
  constructor(message, { retryable = false } = {}) {
    super(message);
    this.retryable = retryable;
  }
}

const TOP_LEVEL_LABELS = [
  "Politische Gemeinde:", "Adresse:", "Verteilnetzbetreiber:",
  "Unterwerksnummer:", "Trafostation:", "Netzebene:", "Anschlussleistung:",
];

const ZIP_CITY_RE = /^(\d{4})\s+(.+)$/;

function firstNonEmptyLine(text) {
  if (!text) return null;
  for (const raw of text.split(/\r?\n/)) {
    const l = raw.trim();
    if (l) return l;
  }
  return null;
}

function sectionText(block, label) {
  const idx = block.indexOf(label);
  if (idx === -1) return null;
  const start = idx + label.length;
  let end = block.length;
  for (const other of TOP_LEVEL_LABELS) {
    if (other === label) continue;
    const pos = block.indexOf(other, start);
    if (pos !== -1 && pos < end) end = pos;
  }
  return block.slice(start, end);
}

function valueAfterLabel(text, label) {
  if (text == null) return null;
  const idx = text.indexOf(label);
  if (idx === -1) return null;
  return firstNonEmptyLine(text.slice(idx + label.length));
}

function splitPlzOrt(plzOrt) {
  if (!plzOrt) return [null, null];
  const m = ZIP_CITY_RE.exec(plzOrt);
  if (m) return [m[1], m[2].trim()];
  return [null, plzOrt];
}

function extractPersonalData(headerText) {
  const empty = { name: null, street: null, plz: null, ort: null };
  const anchor = "Persönliche Daten";
  const idx = headerText.indexOf(anchor);
  if (idx === -1) return empty;
  const section = headerText.slice(idx + anchor.length);
  const lines = section.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
  let zipIdx = null;
  lines.forEach((line, i) => { if (ZIP_CITY_RE.test(line)) zipIdx = i; });
  if (zipIdx === null) return { ...empty, name: lines.length ? lines.join("\n") : null };
  const m = ZIP_CITY_RE.exec(lines[zipIdx]);
  const plz = m[1];
  const ort = m[2].trim();
  const street = zipIdx >= 1 ? lines[zipIdx - 1] : null;
  const nameLines = zipIdx >= 1 ? lines.slice(0, zipIdx - 1) : [];
  const name = nameLines.length ? nameLines.join("\n") : null;
  return { name, street, plz, ort };
}

function extractMesspunktData(block) {
  const mp = {
    messpunkt_id: null,
    politische_gemeinde: { nummer: null, name: null },
    adresse: { strasse: null, plz: null, ort: null },
    verteilnetzbetreiber: null,
    unterwerk: { nummer: null, name: null, gemeinde: null },
    trafostation: { nummer: null, name: null, gemeinde: null },
    netzebene: null,
    anschlussleistung: { typ: null, kw: null },
  };

  const mpMatch = block.match(/CH\d{10,}/);
  mp.messpunkt_id = mpMatch ? mpMatch[0] : null;

  const pgText = sectionText(block, "Politische Gemeinde:");
  mp.politische_gemeinde = {
    nummer: valueAfterLabel(pgText, "Nummer:"),
    name: valueAfterLabel(pgText, "Name:"),
  };

  const addrText = sectionText(block, "Adresse:");
  const [plz, ort] = splitPlzOrt(valueAfterLabel(addrText, "PLZ/Ort:"));
  mp.adresse = {
    strasse: valueAfterLabel(addrText, "Strasse/Hausnummer:"),
    plz, ort,
  };

  mp.verteilnetzbetreiber = firstNonEmptyLine(sectionText(block, "Verteilnetzbetreiber:"));

  const uwText = sectionText(block, "Unterwerksnummer:");
  mp.unterwerk = {
    nummer: valueAfterLabel(uwText, "Nummer:"),
    name: valueAfterLabel(uwText, "Name:"),
    gemeinde: valueAfterLabel(uwText, "Gemeinde:"),
  };

  const tsText = sectionText(block, "Trafostation:");
  mp.trafostation = {
    nummer: valueAfterLabel(tsText, "Nummer:"),
    name: valueAfterLabel(tsText, "Name der Station:"),
    gemeinde: valueAfterLabel(tsText, "Gemeinde:"),
  };

  const netzebeneLine = firstNonEmptyLine(sectionText(block, "Netzebene:"));
  if (netzebeneLine && /^\d+$/.test(netzebeneLine)) {
    mp.netzebene = parseInt(netzebeneLine, 10);
  }

  const alText = sectionText(block, "Anschlussleistung:") || "";
  const alMatch = alText.match(/(Produktionsleistung|Anschlussleistung) in kW:\s*\n?\s*([\d.,]+)/);
  mp.anschlussleistung = alMatch
    ? { typ: alMatch[1], kw: parseFloat(alMatch[2].replace(",", ".")) }
    : { typ: null, kw: null };

  return mp;
}

function parseLegReportText(fullText) {
  if (!fullText.trim()) {
    throw new LegReportParseError("Kein Text extrahiert. Das PDF könnte gescannt/bildbasiert sein. Bitte benutze die PDF-Datei direkt von myEKZ unverändert.");
  }
  const blocks = fullText.split("Messpunktbezeichnung:");
  if (blocks.length < 2) {
    throw new LegReportParseError("Es konnten keine 'Messpunktbezeichnung:'-Anker im Dokument gefunden werden.");
  }
  const [headerBlock, ...mpBlocks] = blocks;
  return {
    customer: extractPersonalData(headerBlock),
    measuring_points: mpBlocks.map(b => extractMesspunktData(b)),
  };
}

async function extractFullText(pdf, onPhase) {
  let fullText = "";
  for (let i = 1; i <= pdf.numPages; i++) {
    onPhase(`Lese Seite ${i} von ${pdf.numPages} …`);
    const page = await pdf.getPage(i);
    const tc = await page.getTextContent();
    let pageText = "";
    for (const item of tc.items) {
      if (typeof item.str !== "string") continue;
      pageText += item.str;
      if (item.hasEOL) pageText += "\n";
    }
    fullText += pageText + "\n";
  }
  return fullText;
}

// =====================================================================
// pdf.js loading
//
// pdf.js is served from our own origin – loading it from a CDN meant that an
// ad blocker, a corporate proxy or a strict privacy setting could break the
// upload in ways we cannot reproduce or debug. Everything below additionally
// assumes that pdf.js may fail or hang anyway, so no step is awaited without a
// timeout and every failure ends in a message the user can act on.
// =====================================================================

let pdfjsPromise = null;
function loadPdfjs() {
  if (!pdfjsPromise) {
    pdfjsPromise = import(`${pdfjsBase}/pdf.min.mjs`)
      .then((lib) => {
        lib.GlobalWorkerOptions.workerSrc = `${pdfjsBase}/pdf.worker.min.mjs`;
        return lib;
      })
      .catch((e) => {
        pdfjsPromise = null;
        throw new LegReportParseError(
          `Die PDF-Bibliothek konnte nicht geladen werden (${e.message || e}).`);
      });
  }
  return pdfjsPromise;
}

// Runs the pdf.js worker code on the main thread instead of in a Web Worker.
// Some browsers and privacy setups refuse to start the module worker, and
// pdf.js then simply never settles its promise.
let mainThreadWorkerPromise = null;
function useMainThreadWorker() {
  if (!mainThreadWorkerPromise) {
    mainThreadWorkerPromise = import(`${pdfjsBase}/pdf.worker.min.mjs`)
      .then((mod) => { globalThis.pdfjsWorker = mod; })
      .catch((e) => {
        mainThreadWorkerPromise = null;
        throw new LegReportParseError(
          `Die PDF-Bibliothek konnte nicht geladen werden (${e.message || e}).`);
      });
  }
  return mainThreadWorkerPromise;
}

// Recent JS features pdf.js relies on. The "legacy" build we serve polyfills
// them, so this is checked *after* loading pdf.js – what matters is the
// environment pdf.js actually ends up running in, not the bare browser.
// Without the polyfills these blow up deep inside pdf.js, where the failure
// never reaches our promise and the upload just appears to hang.
const REQUIRED_FEATURES = {
  "Promise.withResolvers": () => typeof Promise.withResolvers === "function",
  "Map.getOrInsertComputed": () => typeof Map.prototype.getOrInsertComputed === "function",
  "Object.hasOwn": () => typeof Object.hasOwn === "function",
  "structuredClone": () => typeof structuredClone === "function",
  "ReadableStream": () => typeof ReadableStream === "function",
};

// null = not checked yet
let missingFeatures = null;

function checkFeatures() {
  missingFeatures = Object.keys(REQUIRED_FEATURES).filter((name) => {
    try { return !REQUIRED_FEATURES[name](); } catch { return true; }
  });
  return missingFeatures;
}

// Safari < 14 has no File.arrayBuffer()
function readFileBytes(file) {
  if (typeof file.arrayBuffer === "function") return file.arrayBuffer();
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(reader.error || new Error("FileReader fehlgeschlagen"));
    reader.readAsArrayBuffer(file);
  });
}

function withTimeout(promise, ms, describePhase) {
  let timer;
  const timeout = new Promise((_, reject) => {
    timer = setTimeout(() => reject(new LegReportParseError(
      `Zeitüberschreitung nach ${Math.round(ms / 1000)} Sekunden (${describePhase()}).`,
      { retryable: true })), ms);
  });
  // A failure arriving after the timeout is still worth recording, but not
  // worth an unhandled promise rejection.
  promise.catch(e => noteError("verspätet", e?.message || e));
  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
}

async function parsePdfFile(file, onPhase) {
  const pdfjsLib = await loadPdfjs();

  const missing = checkFeatures();
  if (missing.length) {
    throw new LegReportParseError(
      `Dein Browser unterstützt ${missing.length === 1 ? "eine Funktion" : "einige Funktionen"} nicht, `
      + `die zum Lesen des PDF nötig ${missing.length === 1 ? "ist" : "sind"} (${missing.join(", ")}). `
      + "Mit einem aktuellen Browser würde es automatisch klappen.");
  }

  onPhase("Öffne PDF …");
  // pdf.js detaches the buffer it is given, so read the file per attempt.
  const loadingTask = pdfjsLib.getDocument({
    data: await readFileBytes(file),
    isEvalSupported: false,
  });
  let pdf;
  try {
    pdf = await loadingTask.promise;
  } catch (e) {
    // Password protected or damaged files are the user's problem to fix;
    // anything else may well be a broken pdf.js setup.
    const retryable = !/password/i.test(e?.name || "");
    throw new LegReportParseError(`Fehler beim Öffnen des PDFs: ${e.message || e}`, { retryable });
  }
  try {
    return parseLegReportText(await extractFullText(pdf, onPhase));
  } finally {
    // Deliberately not awaited: if pdf.js is wedged, so is destroy().
    Promise.resolve(loadingTask.destroy()).catch(() => {});
  }
}

const PARSE_TIMEOUT_MS = 20000;
const FALLBACK_TIMEOUT_MS = 60000;

// One attempt with the Web Worker, one on the main thread if that looked like
// an infrastructure failure rather than a problem with the document.
async function parsePdfFileWithFallback(file, onPhase) {
  let phase = "Start";
  const trackPhase = (msg) => { phase = msg; onPhase(msg); };

  // No Web Workers at all – don't bother waiting for that attempt to fail
  if (typeof Worker === "undefined" && !globalThis.pdfjsWorker) {
    trackPhase("Verarbeite ohne Web Worker …");
    await useMainThreadWorker();
    return await withTimeout(parsePdfFile(file, trackPhase), FALLBACK_TIMEOUT_MS, () => phase);
  }

  try {
    return await withTimeout(parsePdfFile(file, trackPhase), PARSE_TIMEOUT_MS, () => phase);
  } catch (e) {
    if (globalThis.pdfjsWorker || !(e instanceof LegReportParseError) || !e.retryable) throw e;
    noteError("1. Versuch", e.message);
    trackPhase("Zweiter Versuch ohne Web Worker …");
    await useMainThreadWorker();
    return await withTimeout(parsePdfFile(file, trackPhase), FALLBACK_TIMEOUT_MS, () => phase);
  }
}

// =====================================================================
// LEG zone detection
// =====================================================================

// Addresses are compared structurally (street / house number / suffix) rather
// than as raw strings, because EKZ and the LEG data spell them differently:
// EKZ writes "Stallikerstrasse 1 A" or "Stationsstrasse 4.1", the LEG data
// "stallikerstrasse 1a" resp. "stationsstrasse 4". A character-prefix compare
// also cannot tell "stallikerstrasse 1a" from "stallikerstrasse 18", which sit
// in different zones.

function normAddress(s) {
  return (s || "").toLowerCase().replace(/\s+/g, " ").trim().replace(/[.,\s]+$/, "");
}

// "Stallikerstr." and "Stallikerstrasse" must land on the same key
function normStreet(s) {
  return normAddress(s)
    .replace(/str\./g, "strasse")
    .replace(/ä/g, "ae").replace(/ö/g, "oe").replace(/ü/g, "ue")
    .replace(/[^a-z0-9]+/g, "")
    .replace(/str$/, "strasse");
}

// street, first number, and whatever follows it
const ADDR_RE = /^(.*?)\s*(\d+)\s*(.*)$/;

function parseAddress(raw) {
  const m = ADDR_RE.exec(normAddress(raw));
  if (!m || !m[1].trim()) return null;
  const street = normStreet(m[1]);
  const num = parseInt(m[2], 10);
  const rest = m[3].trim();

  // collective entries: "9-39", "24a-24b", "1a-e"
  const range = /^([a-z]?)\s*-\s*(\d+)\s*[a-z]?$/.exec(rest);
  if (range) {
    return { street, num, suffix: range[1], rangeEnd: parseInt(range[2], 10) };
  }

  // single trailing letter is a house-number suffix ("1a"); a longer word is
  // not ("252assek.", building-insurance numbers)
  const suffix = /^([a-z])(?![a-z])/.exec(rest);
  return { street, num, suffix: suffix ? suffix[1] : "", rangeEnd: null };
}

// Build lookups: exact string → zones, and street → house-number entries
const exactZones = new Map();
const streetIndex = new Map();
for (const leg of legsData) {
  for (const addr of leg.members) {
    const key = normAddress(addr);
    if (!exactZones.has(key)) exactZones.set(key, new Set());
    exactZones.get(key).add(leg.name);

    const parsed = parseAddress(addr);
    if (!parsed) continue;
    if (!streetIndex.has(parsed.street)) streetIndex.set(parsed.street, []);
    streetIndex.get(parsed.street).push({ ...parsed, zone: leg.name });
  }
}

const zonesOf = (entries) => [...new Set(entries.map(e => e.zone))];

function detectZone(mpAdresse) {
  if (!mpAdresse || !mpAdresse.strasse) return [];

  // 1. verbatim match
  const exact = exactZones.get(normAddress(mpAdresse.strasse));
  if (exact && exact.size > 0) return [...exact];

  const q = parseAddress(mpAdresse.strasse);
  if (!q) return [];

  let candidates = streetIndex.get(q.street);
  if (!candidates) {
    // tolerate abbreviated or truncated street names, but only if exactly one
    // known street is compatible
    const compatible = [...streetIndex.keys()]
      .filter(s => s.startsWith(q.street) || q.street.startsWith(s));
    if (compatible.length !== 1) return [];
    candidates = streetIndex.get(compatible[0]);
  }

  const houses = candidates.filter(e => e.rangeEnd === null);

  // 2. same house number and same suffix
  let zones = zonesOf(houses.filter(e => e.num === q.num && e.suffix === q.suffix));
  if (zones.length) return zones;

  // 3. same house number, suffix ignored ("1 A" → "1", "1a" → "1b")
  zones = zonesOf(houses.filter(e => e.num === q.num));
  if (zones.length) return zones;

  // 4. covered by a collective entry ("Friedhofstrasse 9-39"), honouring the
  //    odd/even side when the range has one
  zones = zonesOf(candidates.filter(e =>
    e.rangeEnd !== null &&
    q.num >= e.num && q.num <= e.rangeEnd &&
    !(e.num % 2 === e.rangeEnd % 2 && q.num % 2 !== e.num % 2)
  ));
  if (zones.length) return zones;

  // Unknown house number: do not guess from the street alone – zone borders
  // run between house numbers, and the user can pick the zone manually.
  return [];
}

function inferRole(mp) {
  const typ = mp.anschlussleistung?.typ;
  if (typ === "Produktionsleistung") return "Produzent";
  return "Konsument";
}

