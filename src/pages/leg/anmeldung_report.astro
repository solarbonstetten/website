  mpHint.textContent = "Trage die Messpunkte ein, die du für die LEG anmelden möchtest. "
    + "Bei mehreren Messpunkten (z. B. Bezug und Solaranlage) füge weitere Zeilen hinzu.";
  personHint.textContent = "Bitte ausfüllen.";
  mpList.innerHTML = "";
  addManualRow();
  showForm();
}

function resetUI() {
  mode = "parsed";
  parsedReport = null;
  pdfFile = null;
  parseFailure = null;
  lastPhase = "";
  selectedMps.clear();
  uploadPhase.hidden = false;
  form.hidden = true;
  form.reset();
  resultPhase.hidden = true;
  manualNotice.hidden = true;
  addMpBtn.hidden = true;
  mpList.innerHTML = "";
  formError.hidden = true;
  clearError();
  setStatus("");
  fileInput.value = "";
}

async function handleFile(file) {
  clearError();
  if (file.type && file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) {
    showError("Bitte eine PDF-Datei auswählen.");
    return;
  }
  if (file.size === 0) {
    showError("Die Datei ist leer. Bitte lade das PDF nochmals aus dem myEKZ-Portal herunter.");
    return;
  }
  if (file.size > MAX_PDF_BYTES) {
    showError(`Die Datei ist ${(file.size / 1024 / 1024).toFixed(1)} MB gross – wir können höchstens 1 MB `
      + "entgegennehmen. Bitte schicke sie uns direkt an leg@solarbonstetten.ch.");
    return;
  }

  pdfFile = file;
  lastPhase = "Start";
  setStatus(`Verarbeite «${file.name}» …`);

  try {
    const report = await parsePdfFileWithFallback(file, (phase) => {
      lastPhase = phase;
      setStatus(`«${file.name}» – ${phase}`);
    });
    if (report.measuring_points.length === 0) {
      throw new LegReportParseError("Es konnten keine Messpunkte im PDF gefunden werden.");
    }
    setStatus("");
    showParsedForm(report, file);
  } catch (e) {
    // Not a dead end: the user can fill in the details by hand, and we get the
    // PDF plus the diagnostics to enter the rest ourselves.
    setStatus("");
    const message = e instanceof LegReportParseError
      ? e.message
      : `Unerwarteter Fehler: ${e?.message || e}`;
    noteError("Abbruch", `${e?.name || "Error"} – ${message}`);
    showManualForm(file, message);
  }
}

// Dropzone events
chooseBtn.addEventListener("click", (e) => { e.stopPropagation(); fileInput.click(); });
dropzone.addEventListener("click", (e) => { if (e.target !== chooseBtn) fileInput.click(); });
fileInput.addEventListener("change", () => { if (fileInput.files.length) handleFile(fileInput.files[0]); });

["dragenter", "dragover"].forEach(evt =>
  dropzone.addEventListener(evt, (e) => { e.preventDefault(); e.stopPropagation(); dropzone.classList.add("dragover"); }));
["dragleave", "drop"].forEach(evt =>
  dropzone.addEventListener(evt, (e) => { e.preventDefault(); e.stopPropagation(); dropzone.classList.remove("dragover"); }));
dropzone.addEventListener("drop", (e) => {
  const file = e.dataTransfer?.files?.[0];
  if (file) handleFile(file);
});

resetBtn.addEventListener("click", resetUI);
addMpBtn.addEventListener("click", () => {
  addManualRow().querySelector(".mp-role").focus();
});
backToFormBtn.addEventListener("click", () => {
  resultPhase.hidden = true;
  resultSuccess.hidden = true;
  resultError.hidden = true;
  form.hidden = false;
});

// Form submission
form.addEventListener("submit", async (e) => {
  e.preventDefault();
  formError.hidden = true;

  const get = (id) => {
    const el = form.elements.namedItem(id);
    return el ? el.value.trim() : "";
  };
  const checked = (id) => form.elements.namedItem(id)?.checked ?? false;

  // Validate
  const errors = [];
  if (!get("name")) errors.push("Name ist erforderlich.");
  if (!get("strasse")) errors.push("Strasse ist erforderlich.");
  if (!get("plz")) errors.push("PLZ ist erforderlich.");
  if (!get("ort")) errors.push("Ort ist erforderlich.");
  if (!get("email")) errors.push("E-Mail ist erforderlich.");
  else if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(get("email"))) errors.push("Bitte gib eine gültige E-Mail-Adresse an.");
  if (!checked("smartmeter")) errors.push("Bitte bestätige die Smart-Meter-Voraussetzung.");
  if (!checked("bedingungen")) errors.push("Bitte akzeptiere die Teilnahmebedingungen.");

  // Collect the messpunkte – either from the PDF or from the manual rows
  const messpunkte = [];
  if (mode === "parsed") {
    if (selectedMps.size === 0) errors.push("Bitte wähle mindestens einen Messpunkt aus.");
    for (const idx of [...selectedMps].sort((a, b) => a - b)) {
      const zoneSelect = mpList.querySelector(`.mp-zone-select[data-index="${idx}"]`);
      if (!zoneSelect?.value) {
        errors.push(`Bitte wähle eine LEG-Zone für Messpunkt ${idx + 1}.`);
        continue;
      }
      const mp = parsedReport.measuring_points[idx];
      messpunkte.push({
        messpunkt_id: mp.messpunkt_id,
        rolle: inferRole(mp),
        leg_zone: zoneSelect.value,
        adresse: mp.adresse,
        netzebene: mp.netzebene,
        anschlussleistung: mp.anschlussleistung,
        verteilnetzbetreiber: mp.verteilnetzbetreiber,
        unterwerk: mp.unterwerk,
        trafostation: mp.trafostation,
        politische_gemeinde: mp.politische_gemeinde,
      });
    }
  } else {
    manualRows().forEach((row, i) => {
      const zoneEl = row.querySelector(".mp-zone");
      const idEl = row.querySelector(".mp-id");
      const strasse = row.querySelector(".mp-addr").value.trim();
      // Spaces are part of how the ID is printed, not part of the ID
      const messpunktId = idEl.value.replace(/\s+/g, "").toUpperCase();
      let rowOk = true;

      if (!zoneEl.value) {
        errors.push(`Messpunkt ${i + 1}: Bitte wähle eine LEG-Zone.`);
        zoneEl.classList.add("invalid");
        rowOk = false;
      }
      if (messpunktId && !MESSPUNKT_ID_RE.test(messpunktId)) {
        errors.push(`Messpunkt ${i + 1}: Die Messpunkt-ID muss mit «CH» beginnen, gefolgt von 10–33 Ziffern. `
          + "Lass das Feld leer, wenn du sie nicht findest.");
        idEl.classList.add("invalid");
        rowOk = false;
      }
      if (!rowOk) return;

      messpunkte.push({
        messpunkt_id: messpunktId || null,
        rolle: row.querySelector(".mp-role").value,
        leg_zone: zoneEl.value,
        adresse: {
          strasse: strasse || get("strasse"),
          plz: get("plz"),
          ort: get("ort"),
        },
      });
    });
    if (messpunkte.length === 0 && errors.length === 0) {
      errors.push("Bitte erfasse mindestens einen Messpunkt.");
    }
  }

  // Mark invalid fields
  ["name", "strasse", "plz", "ort", "email"].forEach(id => {
    const el = form.elements.namedItem(id);
    if (el) el.classList.toggle("invalid", !el.value.trim());
  });

  if (errors.length) {
    formError.innerHTML = errors.map(e => escHtml(e)).join("<br>");
    formError.hidden = false;
    formError.scrollIntoView({ behavior: "smooth", block: "center" });
    return;
  }

  // Manual submissions carry the diagnostics along so we can chase down the
  // parser failure afterwards.
  let bemerkungen = get("bemerkungen");
  if (mode === "manual") {
    const note = "--- Automatisch angehängt: PDF konnte im Browser nicht gelesen werden ---\n"
      + buildDiagnostics();
    bemerkungen = bemerkungen ? `${bemerkungen}\n\n${note}` : note;
  }
  if (bemerkungen.length > MAX_BEMERKUNGEN) bemerkungen = `${bemerkungen.slice(0, MAX_BEMERKUNGEN - 1)}…`;

  const payload = {
    art: (form.elements.namedItem("art")).value,
    person: {
      name: get("name"),
      strasse: get("strasse"),
      plz: get("plz"),
      ort: get("ort"),
    },
    kontakt: {
      email: get("email"),
      telefon: get("telefon") || null,
    },
    messpunkte,
    bestaetigungen: {
      smart_meter: true,
      teilnahmebedingungen: `${BEDINGUNGEN_VERSION} (Stand ${BEDINGUNGEN_STAND})`,
    },
    bemerkungen: bemerkungen || null,
  };

  // Disable submit button while sending
  const submitBtn = form.querySelector('button[type="submit"]');
  submitBtn.disabled = true;
  submitBtn.textContent = "Wird gesendet\u2026";

  try {
    const formData = new FormData();
    formData.append("data", JSON.stringify(payload));
    formData.append("pdf", pdfFile);

    const res = await fetch(API_URL, { method: "POST", body: formData });

    form.hidden = true;
    resultPhase.hidden = false;

    if (res.ok) {
      resultSuccess.hidden = false;
      resultError.hidden = true;
    } else if (res.status === 429) {
      resultSuccess.hidden = true;
      resultError.hidden = false;
      resultErrorMsg.textContent =
        "Zu viele Anfragen. Bitte versuche es später erneut oder kontaktiere uns unter leg@solarbonstetten.ch.";
    } else {
      resultSuccess.hidden = true;
      resultError.hidden = false;
      resultErrorMsg.textContent =
        "Ein unerwarteter Fehler ist aufgetreten. Bitte versuche es später erneut oder kontaktiere uns unter leg@solarbonstetten.ch.";
    }

    resultPhase.scrollIntoView({ behavior: "smooth", block: "start" });
  } catch (err) {
    form.hidden = true;
    resultPhase.hidden = false;
    resultSuccess.hidden = true;
    resultError.hidden = false;
    resultErrorMsg.textContent =
      "Verbindungsfehler. Bitte prüfe deine Internetverbindung und versuche es erneut, oder kontaktiere uns unter leg@solarbonstetten.ch.";
    resultPhase.scrollIntoView({ behavior: "smooth", block: "start" });
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = "Anmeldung absenden";
  }
});

// Remove invalid styling on input
form.querySelectorAll("input, select, textarea").forEach(el => {
  el.addEventListener("input", () => el.classList.remove("invalid"));
});
</script>
