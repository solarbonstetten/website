---
/*
  Hinweis auf Vorschau-Seiten (*-preview): sie senden an die neue API auf
  sonne.solarbonstetten.ch und sind zum Testen da, bevor sie die bisherige
  Seite ersetzen. Nicht verlinkt, nicht in der Sitemap, noindex.
*/
interface Props {
  // Wohin Testanmeldungen gehen, z. B. «info@solarbonstetten.ch».
  empfaenger: string;
}
const { empfaenger } = Astro.props;
---
<div class="vorschau-hinweis">
  <div class="container">
    <div class="flex items-start gap-4 bg-sky-50 border-2 border-sky-400 border-l-8 rounded-2xl px-6 py-5 shadow-sm">
      <span class="text-2xl leading-none shrink-0 mt-0.5" aria-hidden="true">🧪</span>
      <p class="text-sm text-slate-700 leading-relaxed m-0">
        <strong>Vorschau:</strong> Diese Seite sendet an die neue API auf sonne.solarbonstetten.ch.
        Testanmeldungen kommen als echte E-Mail bei {empfaenger} an.
      </p>
    </div>
  </div>
</div>

<style>
  /* Abstand zur fixierten Navigation */
  .vorschau-hinweis { padding-top: 7.5rem; }
</style>
